generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled connection — used at runtime by the app
  directUrl = env("DIRECT_URL")     // direct connection — used only by `prisma migrate`
}

// ============================================================
// AUTH & RBAC
// ============================================================

enum CustomerRefundStatus {
  NOT_REQUIRED
  PENDING
  COMPLETED
}

enum StaffRole {
  SUPER_ADMIN       // full access, including financial data and role assignment
  TECHNICAL_SUPPORT // full Admin access; elevated role assigned only by Super Admin
  SUPPORT_ADMIN     // operational access only — financials hidden
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          StaffRole @default(SUPPORT_ADMIN)
  isActive      Boolean   @default(true)
  image         String?
  accounts      Account[]
  sessions      Session[]
  activityLogs  ActivityLog[]
  blogPosts     BlogPost[]
  customerReturns CustomerReturn[]
  inventoryLogsPerformed        InventoryLog[]
  variantInventoryLogsPerformed VariantInventoryLog[]
  assignedEnquiries  Enquiry[]   @relation("EnquiryAssignee")
  assignedComplaints Complaint[] @relation("ComplaintAssignee")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Required by @auth/prisma-adapter even though we primarily use Credentials login
// (keeps the door open for OAuth staff login later without a schema change)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ActivityLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  systemSource String?  // e.g. "paystack_webhook", "stock_reservation_cron" — set when userId is null
  action       String   // e.g. "PRODUCT_CREATE", "ORDER_STATUS_UPDATE"
  resource     String   // e.g. "Product:cuid123"
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
}

// ============================================================
// PRODUCTS
// ============================================================

// Explicit lifecycle: DRAFT -> ACTIVE -> ARCHIVED, with ARCHIVED able to
// return to ACTIVE or DRAFT (undo). Enforced in code by
// lib/utils/product-lifecycle.ts — not just accepted as any free value.
// Deliberately only these three — no "Coming Soon" / "Discontinued".
// "Out of Stock" is NOT a lifecycle status: an ACTIVE product with zero
// stock across all its variants stays ACTIVE and publicly visible: the
// storefront shows "Out of Stock" + a pre-order enquiry action, derived
// live from inventory, never stored as a status.
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Category[] @relation("CategoryHierarchy")
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  // Many-to-many: a product can belong to multiple categories at once
  // (e.g. a tote can be in "Totes", "New Arrivals", and "Office
  // Collection" simultaneously). Prisma manages the join table implicitly
  // — no extra fields needed on the relationship itself for MVP.
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  shortDesc      String
  fullDesc       String     @db.Text
  // See Category model — many-to-many, not a single categoryId FK.
  categories     Category[]
  brand          String     @default("Giftij Brandy")
  sku            String     @unique
  barcode        String?

  // Financial fields — SUPER_ADMIN only at the API layer (see lib/permissions.ts)
  price          Decimal  @db.Decimal(12, 2)
  costPrice      Decimal  @db.Decimal(12, 2)
  // Percentage discount model for MVP. If flat-amount or tiered/scheduled
  // discounts are needed later, introduce a `discountType` enum
  // ("PERCENTAGE" | "FLAT_AMOUNT" | ...) alongside this field rather than
  // repurposing it — documented here so the future expansion path is clear.
  discount       Decimal? @db.Decimal(5, 2) @default(0)

  currency       String   @default("NGN")
  weight         Float?
  dimensions     String?
  warranty       String?
  seoTitle       String?
  seoDescription String?
  status         ProductStatus @default(DRAFT)
  tags           String[]
  // MVP collections model — see lib/collections/featured-flags-provider.ts.
  // Every read of "which products are in collection X" goes through that
  // provider, not a direct `featuredFlags` query, so this can be replaced
  // by a proper Collection model later without changing API consumers.
  featuredFlags  String[] // ["hero","best_sellers","new_arrivals","trending","luxury_collection","recommended","limited_edition","recently_added"]

  // ── Variants ──────────────────────────────────────────────────────
  // A product either has variants or doesn't — never both states at once:
  //   - No variants: stock lives on `inventory` below. `variantType` is null.
  //   - Has variants: stock lives per-variant (ProductVariant.currentStock
  //     etc.). `inventory` is not used (may exist as a zeroed leftover row
  //     but the app never reads/writes it once variants exist).
  // `variantType` is a free-text label ("color", "size", "material", ...)
  // describing what dimension THIS product's variants vary by. It's a
  // string, not an enum, specifically so a brand-new variant dimension
  // (e.g. footwear sizing) never requires a migration — just a different
  // string value and the corresponding admin UI/validation for it.
  variantType    String?
  variants       ProductVariant[]

  specs          ProductSpec[]
  images         ProductImage[]
  inventory      Inventory?
  orderItems     OrderItem[]
  offerSetProducts OfferSetProduct[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([status, createdAt])
}

enum ImageType {
  COVER    // primary product image — shown in storefront listings/grids
  GALLERY  // additional product photos on the detail page (non-variant-specific)
  VARIANT  // the one image belonging to a specific ProductVariant
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  // A variant has AT MOST one image — `@unique` makes this a real 1:1
  // enforced by the database, not just an app-layer assumption. Matches
  // the business rule: "each colour variant has one image only."
  variantId    String?  @unique
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url          String
  cloudinaryId String
  altText      String?
  width        Int?
  height       Int?
  format       String?    // e.g. "webp" — captured from Cloudinary's upload response
  imageType    ImageType  @default(GALLERY)
  sortOrder    Int        @default(0)
}

model ProductSpec {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  // What this value MEANS is given by the parent Product's `variantType`
  // (e.g. variantType "color" -> value "Black"; variantType "size" ->
  // value "42"). Kept as the display/back-compat representation — reports,
  // order history, and any UI that just wants "the label" read this.
  value     String
  // Structured Color × Size fields — added in Phase 9 so a Color+Size
  // combination ("Yellow / 16") is independently queryable instead of
  // being reconstructed by parsing `value`. Populated for the two single-
  // axis cases too (Colour-only -> color set, size null; Size-only ->
  // size set, color null); both stay null for Material/custom variant
  // types, which remain represented by `value` alone — deliberately NOT
  // a generalized variant-option engine, just these two extra columns.
  // `value` remains authoritative for Material/custom; for Colour and/or
  // Size it's now server-derived FROM color/size (see lib/actions/
  // products.ts) rather than the other way around.
  color     String?
  size      String?
  sku       String        @unique
  status    ProductStatus @default(ACTIVE) // lets a single colour (e.g. a discontinued one) be archived independently of the rest of the product
  // No price field: confirmed business rule — all variants of a product
  // share the base Product.price. If a future product type genuinely
  // needs per-variant pricing, that's a deliberate schema addition then,
  // not a default kept "just in case."

  // Each variant is its own independently-tracked stock unit — this is
  // the actual inventory-of-record when a product has variants, not a
  // secondary/derived number. Mirrors the base Inventory model's fields
  // exactly, for consistency and so the same admin adjustment UI pattern
  // applies to both.
  currentStock      Int @default(0)
  reservedStock     Int @default(0)
  soldStock         Int @default(0)
  damagedStock      Int @default(0)
  returnedStock     Int @default(0)
  lowStockThreshold Int @default(5)

  image     ProductImage?
  history   VariantInventoryLog[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// Shared by both InventoryLog and VariantInventoryLog so the two audit
// trails stay consistent. Previously InventoryLog.changeType was a plain
// String whose comment listed "SALE" as a valid value — but the actual
// code never implemented SALE as a distinct type. Fixed here: the enum
// below matches what the code actually supports.
enum StockChangeType {
  INCREASE
  DECREASE
  ADJUST
  DAMAGE
  RETURN
  // Future Returns/RMA module hook point: a dedicated Return/RMA model
  // (referencing OrderItem) can create a RETURN-typed log entry here —
  // or on VariantInventoryLog — without any change to this enum or to
  // how adjustments are recorded. MVP handles this manually (admin uses
  // the existing Inventory Adjustment feature with changeType: RETURN);
  // a full RMA workflow is additive on top of this, not a redesign of it.
}

// ============================================================
// INVENTORY (used only for products with NO variants)
// ============================================================

model Inventory {
  id                String  @id @default(cuid())
  productId         String  @unique
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  currentStock      Int     @default(0)
  reservedStock     Int     @default(0)
  soldStock         Int     @default(0)
  damagedStock      Int     @default(0)
  returnedStock     Int     @default(0)
  warehouseLocation String?
  lowStockThreshold Int     @default(5)
  history           InventoryLog[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model InventoryLog {
  id            String          @id @default(cuid())
  inventoryId   String
  inventory     Inventory       @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  changeType    StockChangeType
  quantity      Int
  reason        String?
  performedById String?
  performedBy   User?           @relation(fields: [performedById], references: [id])
  createdAt     DateTime        @default(now())

  @@index([inventoryId])
  @@index([createdAt])
}

model VariantInventoryLog {
  id            String          @id @default(cuid())
  variantId     String
  variant       ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  changeType    StockChangeType
  quantity      Int
  reason        String?
  performedById String?
  performedBy   User?           @relation(fields: [performedById], references: [id])
  createdAt     DateTime        @default(now())

  @@index([variantId])
  @@index([createdAt])
}

// ============================================================
// ORDERS
// ============================================================

enum CancellationReviewStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  customerReturns CustomerReturn[]
  status          OrderStatus @default(PENDING)
  stockUnavailable Boolean    @default(false)
  cancellationReviewStatus CancellationReviewStatus @default(NONE)
  cancellationRequestedAt DateTime?
  cancellationRequestedBy String?
  shippingAddress Json
  paymentReference String?     @unique
  trackingNumber  String?

  subtotal        Decimal     @db.Decimal(12, 2)
  // profit is derived (subtotal - cost basis) — SUPER_ADMIN only field
  profit          Decimal?    @db.Decimal(12, 2)

  notes           OrderNote[]
  timeline        OrderEvent[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  // Nullable: null when the product has no variants. When it does,
  // this points at exactly which variant was purchased — this FK is
  // also what a future Returns/RMA module would hang off of to know
  // which specific variant's stock to restore.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  customerReturns CustomerReturn[]
}

// Admin-recorded customer returns after delivery; stock restoration is limited to resale-eligible units.
model CustomerReturn {
  id             String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItemId     String
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity        Int
  restockQuantity Int       @default(0)
  refundAmount    Decimal?  @db.Decimal(12, 2)
  refundStatus    CustomerRefundStatus @default(NOT_REQUIRED)
  businessDate    DateTime  @db.Date
  note            String?   @db.Text
  processedById   String
  processedBy     User      @relation(fields: [processedById], references: [id], onDelete: Restrict)
  createdAt       DateTime  @default(now())

  @@index([orderId])
  @@index([orderItemId])
  @@index([businessDate])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  note      String
  createdBy String
  createdAt DateTime @default(now())
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label     String   // "Order Placed", "Payment Confirmed", "Shipped"...
  createdAt DateTime @default(now())
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  address       Json?
  country       String?
  orders        Order[]
  lifetimeValue Decimal   @default(0) @db.Decimal(12, 2)
  lastPurchase  DateTime?
  internalNotes String?   @db.Text
  subscribed    Boolean   @default(false)
  enquiries     Enquiry[]
  complaints    Complaint[]
  // Return events (and every other lifecycle touchpoint) are captured
  // here generically via `label`/`metadata` — no dedicated Returns model
  // needed for MVP to have a record that a return happened.
  timeline      CustomerEvent[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CustomerEvent {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  metadata   Json?
  createdAt  DateTime @default(now())
}

// ============================================================
// COMMUNICATIONS / CRM
// ============================================================

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Enquiry {
  id           String       @id @default(cuid())
  ticketNumber String       @unique
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id])
  subject      String
  message      String       @db.Text
  status       TicketStatus @default(OPEN)
  assignedToId String?
  assignedTo   User?        @relation("EnquiryAssignee", fields: [assignedToId], references: [id])
  replies      Reply[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Complaint {
  id           String       @id @default(cuid())
  ticketNumber String       @unique
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id])
  subject      String
  message      String       @db.Text
  status       TicketStatus @default(OPEN)
  assignedToId String?
  assignedTo   User?        @relation("ComplaintAssignee", fields: [assignedToId], references: [id])
  replies      Reply[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Reply {
  id           String     @id @default(cuid())
  enquiryId    String?
  enquiry      Enquiry?   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  complaintId  String?
  complaint    Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  message      String     @db.Text
  sentByStaff  Boolean    @default(true)
  createdAt    DateTime   @default(now())
}

// ============================================================
// CAMPAIGNS
// ============================================================

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
}

model Campaign {
  id            String         @id @default(cuid())
  subject       String
  previewText   String?
  bodyHtml      String         @db.Text
  recipientRule Json
  status        CampaignStatus @default(DRAFT)
  scheduledFor  DateTime?
  sentAt        DateTime?
  stats         Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum OfferCampaignStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ENDED
}

enum OfferBenefitType {
  DISCOUNT
  FREE_DELIVERY
  GIFT
}

/// Customer-facing promotional campaign. Separate from the email Campaign model above.
model OfferCampaign {
  id                    String              @id @default(cuid())
  title                 String
  slug                  String              @unique
  description           String?             @db.Text
  announcementHtml      String?             @db.Text
  creativeImageUrl      String?
  ctaText               String              @default("Shop the offer")
  status                OfferCampaignStatus @default(DRAFT)
  startsAt              DateTime?
  endsAt                DateTime?
  maxQualifyingOrders   Int?
  qualifyingOrdersCount Int                 @default(0)
  activeOfferSetId      String?
  offerSets             OfferSet[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status, startsAt, endsAt])
}

/// A campaign can contain many sets; only activeOfferSetId is shown to shoppers at a time.
model OfferSet {
  id          String            @id @default(cuid())
  campaignId  String
  campaign    OfferCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String
  description String?           @db.Text
  sortOrder   Int               @default(0)
  isEnabled   Boolean           @default(true)
  products    OfferSetProduct[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([campaignId, sortOrder])
}

/// Offer rules are additive and never overwrite Product.price (the catalogue/base price).
model OfferSetProduct {
  id             String          @id @default(cuid())
  offerSetId     String
  offerSet       OfferSet        @relation(fields: [offerSetId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  discountPercent Decimal?       @db.Decimal(5, 2)
  freeDelivery   Boolean         @default(false)
  giftDescription String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([offerSetId, productId])
  @@index([productId])
}

// ============================================================
// STORE SETTINGS
// ============================================================

/// Singleton store-level settings row — `id` is always the fixed string
/// "singleton", so there is exactly one row, ever (upserted, never
/// created a second time). Deliberately a plain table with named columns
/// rather than a generic key-value config table: there is exactly one
/// store-level setting needed right now (Customer Care WhatsApp). If
/// more show up later, add columns here first; only reach for a
/// key-value shape if that stops being enough — building it now would be
/// the same kind of premature generalization Phase 9 explicitly avoided
/// for ProductVariant.
model StoreSettings {
  id                   String   @id @default("singleton")
  /// Shown to customers when something they want is low or out of
  /// stock — see lib/config/customer-care.ts. Null/absent until an admin
  /// sets it from Settings; no default number is ever hardcoded.
  customerCareWhatsApp String?
  /// Controls whether the public storefront shows the Blog navigation link.
  blogNavigationVisible Boolean @default(false)
  /// Global safety switch: published posts remain noindex until intentionally enabled.
  blogIndexingEnabled   Boolean @default(false)
  updatedAt            DateTime @updatedAt
}

// ============================================================
// BLOG / EDITORIAL CMS
// ============================================================

enum BlogPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum BlogPostType {
  GUIDE
  CUSTOMER_STORY
  FAQ
  ANNOUNCEMENT
}

model BlogCategory {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  description    String?    @db.Text
  seoTitle       String?
  seoDescription String?
  sortOrder      Int        @default(0)
  isActive       Boolean    @default(true)
  posts          BlogPost[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([isActive, sortOrder])
}

model BlogPost {
  id                 String          @id @default(cuid())
  title              String
  slug               String          @unique
  excerpt            String          @db.Text
  /// Markdown source. Rendered as text/Markdown by the storefront, never trusted HTML.
  contentMarkdown    String          @db.Text
  type               BlogPostType    @default(GUIDE)
  status             BlogPostStatus  @default(DRAFT)
  categoryId         String?
  category           BlogCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags               String[]        @default([])
  coverImageUrl      String?
  coverImagePublicId String?
  coverImageAlt      String?
  seoTitle           String?
  seoDescription     String?
  canonicalUrl       String?
  isFeatured         Boolean         @default(false)
  /// Per-article indexing permission; global StoreSettings switch must also be enabled.
  isIndexable        Boolean         @default(false)
  publishedAt        DateTime?
  scheduledAt        DateTime?
  authorId           String?
  author             User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  slugRedirects      BlogPostSlugRedirect[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([type, status])
  @@index([authorId])
  @@index([isFeatured, status, publishedAt])
}

/// Preserves old article URLs when an editor changes a published slug.
model BlogPostSlugRedirect {
  id        String   @id @default(cuid())
  fromSlug  String   @unique
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([postId])
}


enum CheckoutReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

model CheckoutReservation {
  id               String                    @id @default(cuid())
  paymentReference String?                   @unique
  status           CheckoutReservationStatus @default(ACTIVE)
  cart             Json
  expiresAt        DateTime
  consumedAt       DateTime?
  releasedAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([status, expiresAt])
  @@index([createdAt])
}