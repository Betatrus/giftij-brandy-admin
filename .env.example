# Database (Neon, Supabase, or any managed Postgres)
DATABASE_URL="postgresql://user:password@host:5432/giftij_brandy?schema=public"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3000"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend
RESEND_API_KEY=""
# Optional — defaults to a placeholder sender if unset. Must be a domain verified in your Resend account.
RESEND_FROM_ADDRESS="Giftij Brandy <no-reply@giftijbrandy.com>"

# Paystack (webhook verification, and the checkout/initialize +
# orders/status public endpoints, which call the Paystack REST API
# directly using this same key — it is never sent to the storefront)
PAYSTACK_SECRET_KEY=""

# The storefront's own public URL — used to build the Paystack
# `callback_url` (.../checkout/callback) that a customer is redirected to
# after paying. Must match wherever giftij-brandy-frontend is deployed.
STOREFRONT_URL="https://www.giftij.com"

# Customer Care WhatsApp — shown to customers when a product is low/out of
# stock (see the Settings page and lib/config/customer-care.ts). Format:
# full international number, no spaces, no leading +, e.g. "2348012345678".
CUSTOMER_CARE_WHATSAPP=""

# Public API CORS allow-list (comma-separated, no spaces around commas)
PUBLIC_API_ALLOWED_ORIGINS="https://www.giftij.com,https://giftij.com"

# Seed script (first Super Admin account)
SEED_SUPER_ADMIN_EMAIL="bright@giftijbrandy.com"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"
